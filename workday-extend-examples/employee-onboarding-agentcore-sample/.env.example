# Template for local .env. Copy to .env and fill in values produced by scripts/deploy.sh.
# Do NOT commit the real .env — it contains secrets.
# deploy.sh writes this file automatically; manual editing is only needed if extraction fails.

AWS_REGION="us-east-1"

# Required — AgentCore Runtime ARN (from deploy.sh output or `agentcore status`)
RUNTIME_AGENT_ARN="<your-runtime-agent-arn>"

# Required — OAuth2 credentials for invoking the runtime (from deploy.sh output)
RUNTIME_CLIENT_ID="<your-cognito-client-id>"
RUNTIME_CLIENT_SECRET="<your-cognito-client-secret>"
RUNTIME_TOKEN_ENDPOINT="https://<your-cognito-domain>.auth.us-east-1.amazoncognito.com/oauth2/token"
# Must match exactly: [gateway-name]/invoke (copy from deploy.sh output)
RUNTIME_SCOPE="<your-gateway-name>/invoke"

# Required — Gateway MCP endpoint (from deploy.sh output)
# The agent reads this as AGENTCORE_MCP_URL; GATEWAY_URL also works as a fallback.
AGENTCORE_MCP_URL="https://<your-gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp"

# Feature Flags
# Set to 'false' to run the agent without MCP tools (useful for comparison)
AGENT_USE_HR_TOOLS="true"

# Optional — for reference only (not read by application code)
HR_TOOLS_LAMBDA_ARN="<your-lambda-arn>"
GATEWAY_ARN="<your-gateway-arn>"
TARGET_ID="<your-target-id>"
